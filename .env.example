# Higgsfield Console credentials (confirm current location in their docs).
# Users connect their own keys in the app. No operator key fallback.
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERAGEN_SESSION_SECRET=

# Any reachable Postgres instance — a managed provider, or your own
# (e.g. self-hosted on a Pi). Format: postgresql://user:pass@host:5432/db
#
# NOTE: the Prisma CLI reads .env while Next reads .env.local. If they
# disagree, `prisma db push` and the running app target different databases.
DATABASE_URL=

# --- Auth ---------------------------------------------------------------
# better-auth handles sessions, CSRF and cookies; the only login methods are
# social, so there is no password or mail delivery to run.
# BETTER_AUTH_URL is the app's own public origin and is also what the API's
# origin check on writes compares against.
BETTER_AUTH_URL=http://localhost:3000
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=

# Set a pair to enable that button on /sign-in. Set neither and there is no
# way to sign in — use VERAGEN_DEV_USER below for local work.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Local development bypass -------------------------------------------
# Set to an email address and every request is treated as that user, with no
# sign-in. The user row is created on first use.
#
# IGNORED when NODE_ENV=production — that check comes first and no
# environment variable can override it, so a production build cannot be
# talked into this by a stray var.
VERAGEN_DEV_USER=
DEV_ADMIN_PW=

# --- Render worker ------------------------------------------------------
# The worker (`pnpm worker`) claims queued exports from Postgres. It makes
# only outbound connections, so it can run on completely different hardware
# from the web app with no ports open and no tunnel.
#
# Each render drives a headless Chromium wanting 1-2 GB. Raise concurrency
# only with the RAM to back it: the failure mode is the OOM killer, not slow
# renders.
RENDER_CONCURRENCY=1
RENDER_POLL_MS=5000

# S3-compatible object storage for durable clip/export video files.
# Works unchanged against AWS S3, Cloudflare R2, Backblaze B2, or a
# self-hosted MinIO instance.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL your bucket is served from (direct, behind a CDN, or a
# reverse proxy in front of MinIO) — used to build durable video URLs.
S3_PUBLIC_BASE_URL=

# Browser MP4 export is the default. Enable only with an intentionally provisioned worker.
ENABLE_SERVER_EXPORTS=false
# Exact provider output CDN hostnames, comma-separated (no wildcard).
HIGGSFIELD_MEDIA_HOSTS=
# Optional, if your organization requires a Remotion company license.
NEXT_PUBLIC_REMOTION_LICENSE_KEY=
# S3_PUBLIC_BASE_URL above is legacy; private media uses signed URLs.

# --- Mint generation gate ---------------------------------------------------
# Comma-separated emails allowed to generate mint videos. EMPTY = NOBODY:
# mint generation stays on the operator's own collections until
# image-conditioned identity is proven there.
MINT_LAB_USERS=
