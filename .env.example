# Higgsfield Console credentials (confirm current location in their docs).
# Users connect their own keys in the app. No operator key fallback.
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
VERAGEN_SESSION_SECRET=

# Any reachable Postgres instance — a managed provider, or your own
# (e.g. self-hosted on a Pi). Format: postgresql://user:pass@host:5432/db
DATABASE_URL=

# S3-compatible object storage for durable clip/export video files.
# Works unchanged against AWS S3, Cloudflare R2, Backblaze B2, or a
# self-hosted MinIO instance.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Public URL your bucket is served from (direct, behind a CDN, or a
# reverse proxy in front of MinIO) — used to build durable video URLs.
S3_PUBLIC_BASE_URL=
