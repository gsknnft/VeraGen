// Points at any Postgres instance via DATABASE_URL — a managed provider,
// or your own (e.g. self-hosted on a Pi), as long as it's reachable from
// wherever this app runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BrandTemplate {
  none
  teaser
  productReveal
  announcement
}

model Project {
  id        String  @id @default(cuid())
  name      String  @default("Untitled project")
  // Free-text style tokens auto-appended to every clip's prompt in this
  // project ("shot on 35mm, teal-and-orange grade, neon rim light") — the
  // mechanism that makes a set of separately-generated clips read as one
  // world instead of unrelated demos.
  styleLock String?

  // Brand kit — what turns an edit into something a business would post.
  // Durable copy of an uploaded logo; shown as a small corner watermark
  // for the whole video whenever set.
  brandLogoUrl String?
  // End-card text ("Follow @yourhandle", a link) shown on the outro card.
  ctaText      String?
  // Which intro/outro cards wrap the clips — see remotion/durationUtils.ts
  // for exactly what each template adds.
  template     BrandTemplate @default(none)

  // What `ownerFilter` matches on. Required: every create stamps the
  // session user, and the production database was empty when this was
  // tightened, so there was nothing to backfill. An ownerless row cannot exist.
  ownerId    String
  owner      User        @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  clips      Clip[]
  characters Character[]
  exports    Export[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([ownerId])
}

model Character {
  id                String   @id @default(cuid())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  name              String
  // Durable copy of the reference face photo — generations reuse this
  // instead of asking for a fresh upload each time, which is what keeps
  // the same face consistent across many clips.
  referenceImageUrl String
  notes             String?
  /// "network:contract:tokenId" when this character is a holder's NFT, whose
  /// ownership was re-verified against a linked wallet when it was added.
  /// Provenance for holder benefits, and one character per token per project.
  sourceNft         String?
  clips             Clip[]
  createdAt         DateTime @default(now())

  @@index([projectId])
  @@unique([projectId, sourceNft])
}

enum ClipStatus {
  processing
  completed
  failed
}

enum TransitionType {
  cut
  crossfade
}

model Clip {
  submissionKey String? @unique
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  // Position in the timeline; not globally unique, just an ordering hint
  // re-sequenced on every reorder/delete.
  order Int

  prompt         String
  vibe           String
  sourceImageUrl String?
  // Optional lower-third text burned into this clip's segment on export
  // and in the live preview — a caption, not a subtitle track.
  caption        String?

  // Set when this clip was generated from a saved Character rather than
  // a one-off upload.
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterId String?

  status              ClipStatus @default(processing)
  higgsfieldRequestId String?
  errorMessage        String?

  // Durable copy in our own object storage — Higgsfield's own result URL
  // is not guaranteed to stay valid indefinitely.
  videoUrl        String?
  durationSeconds Float?

  // Trim window into the source clip, in seconds.
  trimStart Float  @default(0)
  trimEnd   Float?

  // How this clip transitions in from the previous one on the timeline.
  // Meaningless for the first clip.
  transitionIn TransitionType @default(cut)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

/// An export is a durable job row, not a record of a finished render.
///
/// Rendering drives a real headless Chromium for minutes. Doing that inside
/// the request meant the browser held a connection open for the whole render,
/// a deploy killed anything in flight with no trace, and N simultaneous
/// clicks meant N Chromiums competing for the same RAM. So the route enqueues
/// and a separate worker claims. `videoUrl` is null until it succeeds.
model Export {
  id              String       @id @default(cuid())
  project         Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  videoUrl        String?
  durationSeconds Float
  // "9:16" | "1:1" | "16:9" — see remotion/durationUtils.ts's ASPECTS.
  aspect          String       @default("9:16")
  status          ExportStatus @default(queued)
  /// The timeline as it was when the export was requested. Snapshotted rather
  /// than re-read at render time so that trimming a clip while a render is
  /// queued cannot silently change what comes out.
  inputProps      Json
  attempts        Int          @default(0)
  /// Set when a worker takes the job. A row still `rendering` with an old
  /// `claimedAt` was abandoned by a worker that died, and is reclaimable.
  claimedAt       DateTime?
  errorMessage    String?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([projectId])
  // The claim query's filter: oldest queued job first.
  @@index([status, createdAt])
}

enum ExportStatus {
  queued
  rendering
  completed
  failed
}

/// Every uploaded or generated file, owned by exactly one user.
///
/// Objects are written to the bucket privately and never linked directly;
/// `uploadBuffer` returns `/api/media/<id>` and the bytes are only reachable
/// through a short-lived signed URL issued after an ownership check. The
/// storage key is a UUID under the owner's prefix, so a key is not guessable
/// from anything the client knows.
///
/// `size` is stored rather than queried from the bucket because the per-user
/// allowance is checked on every upload, and that check has to be one cheap
/// aggregate rather than a bucket listing.
model MediaAsset {
  id          String   @id @default(cuid())
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  /// Object key within the bucket. Never returned to a client.
  key         String   @unique
  contentType String
  /// Bytes. Summed per owner to enforce the storage allowance.
  size        Int
  /// Readable by every signed-in user, not just the owner. Set only by the
  /// operator's `pnpm starter:publish` script, for the example clips in the
  /// starter project; no route can set it. Still counts against the owner's
  /// storage, never the viewer's.
  shared      Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([ownerId])
}

// --- Generative collections (e.g. "BittyDragons") -----------------------
// A separate system from Project/Clip: instead of editing one video
// timeline, a Collection defines a trait vocabulary and generates one
// unique, reproducible asset per mint — a name + reference photo isn't
// enough here, a mint number needs to deterministically imply the same
// trait combination every time (so a reveal can't be "regenerated" into
// something rarer after the fact).

model Collection {
  id              String          @id @default(cuid())
  name            String
  // Same mechanism as Project.styleLock — appended to every mint's
  // assembled prompt so the whole set reads as one world.
  styleLock       String?
  // What `ownerFilter` matches on. Required: every create stamps the
  // session user, and the production database was empty when this was
  // tightened, so there was nothing to backfill. An ownerless row cannot exist.
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  // --- Mint-funded generation (see lib/mint-proof.ts, lib/sponsor.ts) ------
  // Holders who mint on this collection's contract can claim one generation
  // per minted token, paid by the sponsor rather than their own key. VeraGen
  // verifies on-chain that the mint happened, on THIS contract, to a wallet
  // the claimant has linked, paying at least mintMinValueWei. Splitting part
  // of the mint price to fund generation is the collection contract's job —
  // auditable on-chain, not something VeraGen can enforce.
  /// NftNetwork key, e.g. "ethereum" or "base".
  chainNetwork       String?
  /// The collection's ERC-721 contract, checksummed.
  contractAddress    String?
  /// Sponsored generations per 24h window across all holders. 0 = claims off.
  sponsoredPerDay    Int             @default(0)
  /// Minimum native value the mint tx must have paid, in wei (decimal string).
  mintMinValueWei    String?

  traitCategories TraitCategory[]
  mints           Mint[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ownerId])
}

model TraitCategory {
  id           String        @id @default(cuid())
  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  name         String
  sortOrder    Int           @default(0)
  options      TraitOption[]

  @@index([collectionId])
}

model TraitOption {
  id             String        @id @default(cuid())
  category       TraitCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  label          String
  // Appended into the mint's prompt when this option is chosen, e.g.
  // "iridescent scales, faint ember glow along the spine".
  promptFragment String
  // Relative rarity — higher picks more often. Plain integers, not
  // percentages (a 1/5/20 split reads as roughly common/uncommon/rare).
  weight         Int           @default(1)
  // This option's art layer (`/api/media/<id>`), normalized on upload to one
  // transparent canvas so layers always align. A mint composites its rolled
  // layers in category sortOrder into its identity image — the HashLips /
  // art-engine model. Minting refuses while any option lacks one: without the
  // art, the only identity left is words.
  layerImageUrl  String?
  mintTraits     MintTrait[]

  @@index([categoryId])
}

enum MintStatus {
  processing
  completed
  failed
}

model Mint {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  // The NFT/drop's mint number — a display label and part of the seed,
  // not the sole source of it once wallet/tx material is supplied.
  mintNumber   Int

  // The exact seed string trait selection was rolled from — persisted so
  // the combination is independently re-derivable and auditable, not just
  // "trust the database." Not the Mint's identity (per ADR-009 in
  // SigilNet's bittyverse package, that stays a character/mint id, not a
  // wallet) — this is provenance for *how* the roll was made, not *who
  // owns it*.
  seed          String
  /// Hash of the chosen trait options — this mint's combination, its "DNA".
  /// Unique per collection: two mints cannot be the same character. A roll
  /// that collides is re-rolled with a recorded salt rather than served as a
  /// duplicate, because rarity means nothing if the same combination can be
  /// minted twice.
  dna           String?
  walletAddress String?
  txHash        String?

  prompt              String
  /// The composited still (`/api/media/<id>`): the mint's identity (ADR-011).
  /// The video is generated FROM this image, never from the prompt alone, so
  /// the character on screen is the one the traits describe.
  imageUrl            String?
  status              MintStatus @default(processing)
  higgsfieldRequestId String?
  errorMessage        String?

  videoUrl        String?
  durationSeconds Float?

  /// The holder who claimed this mint with an on-chain mint proof; null for
  /// mints the collection owner generated in Mint Lab. For a claimed mint,
  /// mintNumber IS the on-chain tokenId, so a token can be claimed only once.
  claimedBy   User?       @relation("ClaimedMints", fields: [claimedById], references: [id], onDelete: SetNull)
  claimedById String?

  traits    MintTrait[]
  createdAt DateTime    @default(now())

  @@unique([collectionId, mintNumber])
  @@unique([collectionId, dna])
  @@index([claimedById])
}

model MintTrait {
  id            String      @id @default(cuid())
  mint          Mint        @relation(fields: [mintId], references: [id], onDelete: Cascade)
  mintId        String
  traitOption   TraitOption @relation(fields: [traitOptionId], references: [id], onDelete: Cascade)
  traitOptionId String

  @@unique([mintId, traitOptionId])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  collections   Collection[]
  mediaAssets   MediaAsset[]
  wallets       LinkedWallet[]
  claimedMints  Mint[]         @relation("ClaimedMints")
  shareLinks    ShareLink[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

/// A wallet the user has PROVEN they control, by signing an EIP-4361 (Sign-In
/// with Ethereum) message bound to their account. Distinct from better-auth's
/// own SIWE plugin, which signs in as a separate wallet user: this links a
/// wallet to the account the person already has, so "pick your NFT" and
/// holder benefits attach to one identity.
///
/// `address` is unique across all users: one wallet, one account. Stored
/// checksummed (EIP-55) so comparisons are exact.
model LinkedWallet {
  id        String   @id @default(cuid())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userId    String
  address   String   @unique
  /// Chain the proof was signed on. Ownership is per-address; this records
  /// what was actually signed.
  chainId   Int
  createdAt DateTime @default(now())

  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}

model UsageQuota {
  key String @id
  count Int
  expiresAt DateTime
}

/// Public capability URL for a finished (or in-progress) video. Media stays
/// private in S3; `/api/share/<token>/media` is the only public read path.
model ShareLink {
  id          String   @id @default(cuid())
  /// Unguessable token used in `/s/[token]`.
  token       String   @unique
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  ownerId     String
  title       String
  description String?
  /// `/api/media/<id>` poster for OG/Twitter cards (unfurls before video is ready).
  posterUrl   String?
  /// `/api/media/<id>` playable MP4 once generation finishes.
  videoUrl    String?
  clipId      String?
  mintId      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([ownerId])
  @@index([clipId])
  @@index([mintId])
}

