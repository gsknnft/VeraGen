// Points at any Postgres instance via DATABASE_URL — a managed provider,
// or your own (e.g. self-hosted on a Pi), as long as it's reachable from
// wherever this app runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id      String  @id @default(cuid())
  name    String  @default("Untitled project")
  // Free-text style tokens auto-appended to every clip's prompt in this
  // project ("shot on 35mm, teal-and-orange grade, neon rim light") — the
  // mechanism that makes a set of separately-generated clips read as one
  // world instead of unrelated demos.
  styleLock  String?
  clips      Clip[]
  characters Character[]
  exports    Export[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Character {
  id                String  @id @default(cuid())
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  name              String
  // Durable copy of the reference face photo — generations reuse this
  // instead of asking for a fresh upload each time, which is what keeps
  // the same face consistent across many clips.
  referenceImageUrl String
  notes             String?
  clips             Clip[]
  createdAt         DateTime @default(now())

  @@index([projectId])
}

enum ClipStatus {
  processing
  completed
  failed
}

enum TransitionType {
  cut
  crossfade
}

model Clip {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  // Position in the timeline; not globally unique, just an ordering hint
  // re-sequenced on every reorder/delete.
  order Int

  prompt         String
  vibe           String
  sourceImageUrl String?

  // Set when this clip was generated from a saved Character rather than
  // a one-off upload.
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterId String?

  status              ClipStatus @default(processing)
  higgsfieldRequestId String?
  errorMessage        String?

  // Durable copy in our own object storage — Higgsfield's own result URL
  // is not guaranteed to stay valid indefinitely.
  videoUrl        String?
  durationSeconds Float?

  // Trim window into the source clip, in seconds.
  trimStart Float @default(0)
  trimEnd   Float?

  // How this clip transitions in from the previous one on the timeline.
  // Meaningless for the first clip.
  transitionIn TransitionType @default(cut)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model Export {
  id              String   @id @default(cuid())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  videoUrl        String
  durationSeconds Float
  createdAt       DateTime @default(now())
}

// --- Generative collections (e.g. "BittyDragons") -----------------------
// A separate system from Project/Clip: instead of editing one video
// timeline, a Collection defines a trait vocabulary and generates one
// unique, reproducible asset per mint — a name + reference photo isn't
// enough here, a mint number needs to deterministically imply the same
// trait combination every time (so a reveal can't be "regenerated" into
// something rarer after the fact).

model Collection {
  id              String          @id @default(cuid())
  name            String
  // Same mechanism as Project.styleLock — appended to every mint's
  // assembled prompt so the whole set reads as one world.
  styleLock       String?
  traitCategories TraitCategory[]
  mints           Mint[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model TraitCategory {
  id           String       @id @default(cuid())
  collection   Collection   @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  name         String
  sortOrder    Int          @default(0)
  options      TraitOption[]

  @@index([collectionId])
}

model TraitOption {
  id             String        @id @default(cuid())
  category       TraitCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  label          String
  // Appended into the mint's prompt when this option is chosen, e.g.
  // "iridescent scales, faint ember glow along the spine".
  promptFragment String
  // Relative rarity — higher picks more often. Plain integers, not
  // percentages (a 1/5/20 split reads as roughly common/uncommon/rare).
  weight         Int           @default(1)
  mintTraits     MintTrait[]

  @@index([categoryId])
}

enum MintStatus {
  processing
  completed
  failed
}

model Mint {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  // The NFT/drop's mint number — the seed for deterministic trait
  // selection, not just a display label.
  mintNumber   Int

  prompt              String
  status              MintStatus @default(processing)
  higgsfieldRequestId String?
  errorMessage        String?

  videoUrl        String?
  durationSeconds Float?

  traits    MintTrait[]
  createdAt DateTime    @default(now())

  @@unique([collectionId, mintNumber])
}

model MintTrait {
  id            String      @id @default(cuid())
  mint          Mint        @relation(fields: [mintId], references: [id], onDelete: Cascade)
  mintId        String
  traitOption   TraitOption @relation(fields: [traitOptionId], references: [id], onDelete: Cascade)
  traitOptionId String

  @@unique([mintId, traitOptionId])
}
