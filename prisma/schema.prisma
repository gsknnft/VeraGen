// Points at any Postgres instance via DATABASE_URL — a managed provider,
// or your own (e.g. self-hosted on a Pi), as long as it's reachable from
// wherever this app runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Project {
  id      String  @id @default(cuid())
  name    String  @default("Untitled project")
  // Free-text style tokens auto-appended to every clip's prompt in this
  // project ("shot on 35mm, teal-and-orange grade, neon rim light") — the
  // mechanism that makes a set of separately-generated clips read as one
  // world instead of unrelated demos.
  styleLock  String?
  clips      Clip[]
  characters Character[]
  exports    Export[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Character {
  id                String  @id @default(cuid())
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  name              String
  // Durable copy of the reference face photo — generations reuse this
  // instead of asking for a fresh upload each time, which is what keeps
  // the same face consistent across many clips.
  referenceImageUrl String
  notes             String?
  clips             Clip[]
  createdAt         DateTime @default(now())

  @@index([projectId])
}

enum ClipStatus {
  processing
  completed
  failed
}

enum TransitionType {
  cut
  crossfade
}

model Clip {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  // Position in the timeline; not globally unique, just an ordering hint
  // re-sequenced on every reorder/delete.
  order Int

  prompt         String
  vibe           String
  sourceImageUrl String?

  // Set when this clip was generated from a saved Character rather than
  // a one-off upload.
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterId String?

  status              ClipStatus @default(processing)
  higgsfieldRequestId String?
  errorMessage        String?

  // Durable copy in our own object storage — Higgsfield's own result URL
  // is not guaranteed to stay valid indefinitely.
  videoUrl        String?
  durationSeconds Float?

  // Trim window into the source clip, in seconds.
  trimStart Float @default(0)
  trimEnd   Float?

  // How this clip transitions in from the previous one on the timeline.
  // Meaningless for the first clip.
  transitionIn TransitionType @default(cut)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model Export {
  id              String   @id @default(cuid())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  videoUrl        String
  durationSeconds Float
  createdAt       DateTime @default(now())
}
