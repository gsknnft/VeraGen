// Points at any Postgres instance via DATABASE_URL — a managed provider,
// or your own (e.g. self-hosted on a Pi), as long as it's reachable from
// wherever this app runs.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum BrandTemplate {
  none
  teaser
  productReveal
  announcement
}

model Project {
  id        String  @id @default(cuid())
  name      String  @default("Untitled project")
  // Free-text style tokens auto-appended to every clip's prompt in this
  // project ("shot on 35mm, teal-and-orange grade, neon rim light") — the
  // mechanism that makes a set of separately-generated clips read as one
  // world instead of unrelated demos.
  styleLock String?

  // Brand kit — what turns an edit into something a business would post.
  // Durable copy of an uploaded logo; shown as a small corner watermark
  // for the whole video whenever set.
  brandLogoUrl String?
  // End-card text ("Follow @yourhandle", a link) shown on the outro card.
  ctaText      String?
  // Which intro/outro cards wrap the clips — see remotion/durationUtils.ts
  // for exactly what each template adds.
  template     BrandTemplate @default(none)

  // What `ownerFilter` matches on. Nullable so the migration can land on a
  // database with existing rows; `withAccess` treats null as unowned and no
  // session matches it, so pre-existing rows become invisible rather than
  // public. Backfill, then tighten to required.
  ownerId    String?
  owner      User?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  clips      Clip[]
  characters Character[]
  exports    Export[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([ownerId])
}

model Character {
  id                String   @id @default(cuid())
  project           Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId         String
  name              String
  // Durable copy of the reference face photo — generations reuse this
  // instead of asking for a fresh upload each time, which is what keeps
  // the same face consistent across many clips.
  referenceImageUrl String
  notes             String?
  clips             Clip[]
  createdAt         DateTime @default(now())

  @@index([projectId])
}

enum ClipStatus {
  processing
  completed
  failed
}

enum TransitionType {
  cut
  crossfade
}

model Clip {
  id        String  @id @default(cuid())
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId String

  // Position in the timeline; not globally unique, just an ordering hint
  // re-sequenced on every reorder/delete.
  order Int

  prompt         String
  vibe           String
  sourceImageUrl String?
  // Optional lower-third text burned into this clip's segment on export
  // and in the live preview — a caption, not a subtitle track.
  caption        String?

  // Set when this clip was generated from a saved Character rather than
  // a one-off upload.
  character   Character? @relation(fields: [characterId], references: [id], onDelete: SetNull)
  characterId String?

  status              ClipStatus @default(processing)
  higgsfieldRequestId String?
  errorMessage        String?

  // Durable copy in our own object storage — Higgsfield's own result URL
  // is not guaranteed to stay valid indefinitely.
  videoUrl        String?
  durationSeconds Float?

  // Trim window into the source clip, in seconds.
  trimStart Float  @default(0)
  trimEnd   Float?

  // How this clip transitions in from the previous one on the timeline.
  // Meaningless for the first clip.
  transitionIn TransitionType @default(cut)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId, order])
}

model Export {
  id              String   @id @default(cuid())
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  projectId       String
  videoUrl        String
  durationSeconds Float
  // "9:16" | "1:1" | "16:9" — see remotion/durationUtils.ts's ASPECTS.
  aspect          String   @default("9:16")
  createdAt       DateTime @default(now())
}

// --- Generative collections (e.g. "BittyDragons") -----------------------
// A separate system from Project/Clip: instead of editing one video
// timeline, a Collection defines a trait vocabulary and generates one
// unique, reproducible asset per mint — a name + reference photo isn't
// enough here, a mint number needs to deterministically imply the same
// trait combination every time (so a reveal can't be "regenerated" into
// something rarer after the fact).

model Collection {
  id              String          @id @default(cuid())
  name            String
  // Same mechanism as Project.styleLock — appended to every mint's
  // assembled prompt so the whole set reads as one world.
  styleLock       String?
  // What `ownerFilter` matches on. Nullable so the migration can land on a
  // database with existing rows; `withAccess` treats null as unowned and no
  // session matches it, so pre-existing rows become invisible rather than
  // public. Backfill, then tighten to required.
  ownerId         String?
  owner           User?           @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  traitCategories TraitCategory[]
  mints           Mint[]
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([ownerId])
}

model TraitCategory {
  id           String        @id @default(cuid())
  collection   Collection    @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  name         String
  sortOrder    Int           @default(0)
  options      TraitOption[]

  @@index([collectionId])
}

model TraitOption {
  id             String        @id @default(cuid())
  category       TraitCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  categoryId     String
  label          String
  // Appended into the mint's prompt when this option is chosen, e.g.
  // "iridescent scales, faint ember glow along the spine".
  promptFragment String
  // Relative rarity — higher picks more often. Plain integers, not
  // percentages (a 1/5/20 split reads as roughly common/uncommon/rare).
  weight         Int           @default(1)
  mintTraits     MintTrait[]

  @@index([categoryId])
}

enum MintStatus {
  processing
  completed
  failed
}

model Mint {
  id           String     @id @default(cuid())
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  collectionId String
  // The NFT/drop's mint number — a display label and part of the seed,
  // not the sole source of it once wallet/tx material is supplied.
  mintNumber   Int

  // The exact seed string trait selection was rolled from — persisted so
  // the combination is independently re-derivable and auditable, not just
  // "trust the database." Not the Mint's identity (per ADR-009 in
  // SigilNet's bittyverse package, that stays a character/mint id, not a
  // wallet) — this is provenance for *how* the roll was made, not *who
  // owns it*.
  seed          String
  walletAddress String?
  txHash        String?

  prompt              String
  status              MintStatus @default(processing)
  higgsfieldRequestId String?
  errorMessage        String?

  videoUrl        String?
  durationSeconds Float?

  traits    MintTrait[]
  createdAt DateTime    @default(now())

  @@unique([collectionId, mintNumber])
}

model MintTrait {
  id            String      @id @default(cuid())
  mint          Mint        @relation(fields: [mintId], references: [id], onDelete: Cascade)
  mintId        String
  traitOption   TraitOption @relation(fields: [traitOptionId], references: [id], onDelete: Cascade)
  traitOptionId String

  @@unique([mintId, traitOptionId])
}

model User {
  id            String    @id
  name          String
  email         String
  emailVerified Boolean   @default(false)
  image         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  sessions      Session[]
  accounts      Account[]
  projects      Project[]
  collections   Collection[]

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model RateLimit {
  id          String @id
  key         String
  count       Int
  lastRequest BigInt

  @@unique([key])
  @@map("rateLimit")
}
